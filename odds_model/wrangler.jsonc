{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "belch-bets",
  "compatibility_date": "2026-10-12",
  // Static site: the daily pipeline writes data/site (index.html, picks.json, history/) and runs `wrangler deploy`.
  // worker.js runs first on every request (the private-link check), then serves the files.
  // Secrets (wrangler secret put): VIEW_KEY, the private link's key; GITHUB_TOKEN, for the crons below.
  "main": "worker.js",
  // Daily runs: results 9:00 AM ET (13:00 UTC in EDT, 14:00 in EST), picks 12:00 PM ET (16:00 / 17:00); worker.js keeps
  // the right one. Evenings every 15 min (5 PM-12:45 AM ET): a closing-line run only when a bet is about to tip.
  "triggers": { "crons": ["0 13,14,16,17 * * *", "*/15 21-23,0-4 * * *"] },
  "assets": {
    "directory": "data/site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
