{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "belch-bets",
  "compatibility_date": "2026-10-12",
  // Static site: the daily pipeline writes data/site (index.html, picks.json, history/) and runs `wrangler deploy`.
  // worker.js answers /api/* (the "Update now" button); everything else is served straight from the files.
  "main": "worker.js",
  "assets": {
    "directory": "data/site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
